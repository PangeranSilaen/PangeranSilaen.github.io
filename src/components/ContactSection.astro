    <div class="contact-row reveal">
      <a class="contact-email" href="mailto:pangeranborneo9@gmail.com">
        pangeranborneo9@gmail.com
      </a>
      <div class="contact-links" aria-label="Social links and back to top">
        <a
          class="social-icon-link"
          href="https://github.com/PangeranSilaen"
          target="_blank"
          rel="noreferrer"
